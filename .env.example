NODE_ENV=development
PORT=3000

# URL pública de esta aplicación. En producción debe ser HTTPS.
APP_URL=http://localhost:3000

# Credenciales de la aplicación de Mercado Pago.
MP_ACCESS_TOKEN=APP_USR-pon_aqui_tu_access_token
MP_WEBHOOK_SECRET=pon_aqui_la_clave_secreta_de_webhooks

# Precio de la licencia permanente (ejemplo: 21.000 COP / aprox. $5 USD).
LICENSE_PRICE=21000
LICENSE_CURRENCY=COP
PRODUCT_NAME=KSPR CLI — Licencia permanente

# Endpoint de Formspree para enviar la confirmación del pago.
FORMSPREE_ENDPOINT=https://formspree.io/f/mvkgojge

# Opcional: claves separadas por coma. También puedes usar access-codes.md.
# LICENSE_KEYS=KSPR-KEY-001,KSPR-KEY-002
